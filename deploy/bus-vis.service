[Unit]
Description=Teal bus exterior studio
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mehek/sites/bus-vis
ExecStart=/usr/bin/python3 -m http.server 5009 --bind 0.0.0.0 --directory /home/mehek/sites/bus-vis/dist
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
